# Ollama defaults suitable for a local, memory-constrained setup.
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_KEEP_ALIVE=0
OLLAMA_NUM_CTX=512
OLLAMA_NUM_PREDICT=180
# OLLAMA_NUM_THREAD=2
OLLAMA_TIMEOUT=180

# Optional: set this to the local path of your Obsidian vault.
# When unset, Ghost Writer uses ~/Obsidian.
# OBSIDIAN_VAULT=/path/to/your/vault

# Optional Ghost Writer generation limits.
GHOSTWRITER_NUM_CTX=2048
GHOSTWRITER_NUM_PREDICT=1024
# GHOSTWRITER_OLLAMA_CLOUD_MODEL=gpt-oss:120b-cloud
# GHOSTWRITER_CLOUD_NUM_CTX=32768
# GHOSTWRITER_CLOUD_NUM_PREDICT=8192
